    {
      "name": "Muscle chart defaults to Est. 1RM with strength level",
      "path": "/?demo=1&muscle=chest",
      "expectText": "Intermediate"
    },
    {
      "name": "Quads strength score rolls up from the squat",
      "path": "/?demo=1&muscle=quads",
      "expectText": "Novice"
    },
    {
      "name": "Body map strength legend renders in demo",
      "path": "/?demo=1&progress=1",
      "expectText": "Advanced"
    },
    {
      "name": "Body map mode toggle renders",
      "path": "/?demo=1&progress=1",
      "expectSelector": "[data-action=\"map-mode\"]"
    },
    {
      "name": "Frequency mode shows the growth legend",
      "path": "/?demo=1&progress=1&freq=1",
      "expectText": "On track"
    },
    {
      "name": "Muscle drill-in shows the frequency status line",
      "path": "/?demo=1&muscle=chest",
      "expectText": "sets/wk"
    },
    {
      "name": "Demo chest frequency reads On track",
      "path": "/?demo=1&muscle=chest",
      "expectText": "On track"
    },
    {
      "name": "Bodyweight prompt shows for a fresh user",
      "path": "/?progress=1&strength=1",
      "expectText": "Set your bodyweight"
    },
    {
      "name": "Keyboard overlays viewport (resizes-visual)",
      "path": "/",
      "expectSelector": "meta[content*=\"resizes-visual\"]"
    },
    {
      "name": "Native kit stylesheet loads",
      "path": "/",
      "expectSelector": "link[href*=\"usernode-native\"]"
    },
    {
      "name": "Native kit script loads",
      "path": "/",
      "expectSelector": "script[src*=\"usernode-native\"]"
    },
    {
      "name": "Safe-area viewport (viewport-fit=cover)",
      "path": "/",
      "expectSelector": "meta[content*=\"viewport-fit=cover\"]"
    },
    {
      "name": "Kit nav bar renders in session view",
      "path": "/?demo=1&session=900002",
      "expectSelector": ".un-navbar"
    },
    {
      "name": "Inset-grouped session list on home",
      "path": "/?demo=1",
      "expectSelector": ".un-group"
    },
    {
      "name": "Drop-set switch renders in the set form",
      "path": "/?demo=1&session=900002&addset=1",
      "expectSelector": ".un-switch"
    },
    {
      "name": "Fixed app shell (static keyboard layout)",
      "path": "/",
      "expectSelector": "#scroll"
    },
    {
      "name": "Staging tester sees copied demo workouts",
      "path": "/",
      "expectText": "Staging demo"
    },
    {
      "name": "Rest timer is a fixed body-level dock",
      "path": "/",
      "expectSelector": "#rest-dock"
    },
    {
      "name": "Rest readout renders in a session",
      "path": "/?demo=1&session=900002",
      "expectSelector": "#stopwatch"
    },
    {
      "name": "Long exercise note renders in full",
      "path": "/?demo=1&session=900002",
      "expectText": "stop two reps short of failure on every working set"
    },
    {
      "name": "Notes render as wrapping paragraphs",
      "path": "/?demo=1&session=900002",
      "expectSelector": "[data-note=\"entry\"]"
    },
    {
      "name": "Open rest card offers +15s, Pause and Skip",
      "path": "/?demo=1&session=900002&rest=1",
      "expectSelector": "[data-action=\"rest-extend\"]"
    },
    {
      "name": "Open rest card offers Skip",
      "path": "/?demo=1&session=900002&rest=1",
      "expectSelector": "[data-action=\"rest-skip\"]"
    },
    {
      "name": "Rest length dial renders",
      "path": "/?demo=1&session=900002&rest=1",
      "expectSelector": "[data-rest-dial]"
    },
    {
      "name": "Rest default length comes from user settings (1:30)",
      "path": "/?demo=1&session=900002&rest=1",
      "expectText": "1:30"
    },
    {
      "name": "Idle rest card offers Start",
      "path": "/?demo=1&session=900002&restcard=1",
      "expectSelector": "[data-action=\"rest-start\"]"
    },
    {
      "name": "Rest card offers the sound-at-zero switch",
      "path": "/?demo=1&session=900002&restcard=1",
      "expectSelector": "[data-action=\"rest-sound\"]"
    },
    {
      "name": "+15s extends the running rest",
      "path": "/?demo=1&session=900002&rest=1&restact=extend",
      "expectSelector": "body[data-rest-target=\"105\"]"
    },
    {
      "name": "Pause freezes the countdown",
      "path": "/?demo=1&session=900002&rest=1&restact=pause",
      "expectSelector": "body[data-rest-paused=\"1\"]"
    },
    {
      "name": "Paused card offers Resume",
      "path": "/?demo=1&session=900002&rest=1&restact=pause",
      "expectText": "Resume"
    },
    {
      "name": "Skip ends the rest",
      "path": "/?demo=1&session=900002&rest=1&restact=skip",
      "expectSelector": "body[data-rest-running=\"0\"]"
    },
    {
      "name": "End-of-rest cue beeps when sound is on",
      "path": "/?demo=1&session=900002&rest=1&restfire=1",
      "expectSelector": "body[data-rest-beep=\"1\"]"
    },
    {
      "name": "End-of-rest cue vibrates when supported",
      "path": "/?demo=1&session=900002&rest=1&restfire=1",
      "expectSelector": "body[data-rest-vibrate=\"1\"]"
    },
    {
      "name": "End-of-rest cue flashes the card",
      "path": "/?demo=1&session=900002&rest=1&restfire=1",
      "expectSelector": "body[data-rest-flashed=\"1\"]"
    },
    {
      "name": "Sound off means no beep at zero",
      "path": "/?demo=1&session=900002&rest=1&restfire=1&restsound=0",
      "expectSelector": "body[data-rest-beep=\"0\"]"
    },
    {
      "name": "Remaining time survives a page refresh in the same session",
      "path": "/?session=latest&restsim=1",
      "expectText": "0:45",
      "expectSelector": "body[data-rest-paused=\"1\"]"
    },
    {
      "name": "Timer stops when the session view is left",
      "path": "/?session=latest&logset=1&home=1",
      "expectSelector": "body[data-rest-running=\"0\"]"
    },
    {
      "name": "Set form offers the Log set button",
      "path": "/?demo=1&session=900002&addset=1",
      "expectText": "Log set"
    },
    {
      "name": "Log set submit control renders",
      "path": "/?demo=1&session=900002&addset=1",
      "expectSelector": "#set-form button[type=\"submit\"]"
    },
    {
      "name": "Rest timer steps aside while the set form is open",
      "path": "/?demo=1&session=900002&addset=1",
      "expectSelector": "body:has(#set-form) #rest-dock.hidden"
    },
    {
      "name": "Rest timer shows in a session with nothing open",
      "path": "/?demo=1&session=900002",
      "expectSelector": "#rest-dock:not(.hidden) #stopwatch"
    },
    {
      "name": "Rest timer steps aside while the add-exercise sheet is open",
      "path": "/?demo=1&session=900002&picker=1",
      "expectSelector": "body:has(#picker-search) #rest-dock.hidden"
    },
    {
      "name": "Logging a set pops the floating rest card",
      "path": "/?session=latest&logset=1",
      "expectSelector": "#rest-card:not(.hidden)",
      "id": "rest.card-after-set",
      "visual": true,
      "impact": ["public/index.html", "server.js"]
    },
    {
      "name": "Logging a set arms the rest timer",
      "path": "/?session=latest&logset=1",
      "expectSelector": "#stopwatch[data-armed=\"1\"]"
    },
    {
      "name": "The rest countdown starts on its own against the saved default",
      "path": "/?session=latest&logset=1",
      "expectSelector": "body[data-rest-target=\"90\"]"
    },
    {
      "name": "Logged set row renders once the save settles",
      "path": "/?session=latest&logset=1",
      "expectSelector": "[data-swipe^=\"set:\"]"
    },
    {
      "name": "Latest-session deep link opens a workout",
      "path": "/?session=latest",
      "expectText": "Add exercise"
    },
    {
      "name": "A changed rest default saves to user settings (2:00 round trip)",
      "path": "/?session=latest&rest=1&resttarget=120",
      "expectText": "2:00"
    }
  ],
  "admins": [
    "evan"
  ],
  "governance": {
    "approvers": "invited",
    "approvals": "default"
  },
  "visibility": {
    "build": "public",
    "view": "public"
  }

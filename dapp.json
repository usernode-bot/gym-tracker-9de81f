      "expectText": "Staging demo"
    },
    {
      "name": "Home renders for real user",
      "path": "/",
      "expectText": "Start workout"
    },
    {
      "name": "Theme switcher renders",
      "path": "/",
      "expectSelector": "[data-action=\"set-theme\"]"
    },
    {
      "name": "Appearance sheet opens",
      "path": "/?appearance=1",
      "expectSelector": "[data-action=\"set-accent\"]"
    },
    {
      "name": "Appearance entry point on home",
      "path": "/",
      "expectSelector": "[data-action=\"open-appearance\"]"
    },
    {
      "name": "Preset swatches render",
      "path": "/?appearance=1",
      "expectSelector": "[data-accent-preset]"
